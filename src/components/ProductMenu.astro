---
// Product Showcase - Menú Online + Chatbot
---

<section id="product-menu" class="py-24 bg-gray-50">
  <div class="container mx-auto px-8">
    <!-- Section Header -->
    <div class="text-center mb-12 reveal">
      <span class="inline-flex items-center px-4 py-2 bg-primary-turquoise/10 text-primary-turquoise text-sm font-semibold rounded-full border border-primary-turquoise/30 mb-6">
        <i class="las la-box-open mr-2"></i>
        <span data-i18n="menu.badge">Producto</span>
      </span>
      <h2 class="text-4xl md:text-5xl font-display font-bold text-primary-dark mb-6" data-i18n="menu.title">
        Menú Online — Videos IA + Chatbot
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto" data-i18n="menu.subtitle">
        Menú digital para restaurantes: cada plato como video generado con IA a partir de tus fotos, con chatbot que responde precios, horarios y dudas 24/7
      </p>
    </div>

    <!-- Demo GIF -->
    <div class="max-w-2xl mx-auto mb-16 reveal">
      <div class="rounded-lg overflow-hidden shadow-lg border border-gray-100 bg-black">
        <img
          src="/menu-demo.gif"
          alt="Menú online: platos en video con precios y chatbot respondiendo preguntas"
          class="w-full h-auto"
          loading="lazy"
        >
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
      <!-- Modules -->
      <div class="reveal">
        <h3 class="text-2xl font-display font-semibold text-primary-dark mb-6" data-i18n="menu.modulesTitle">
          Qué Incluye
        </h3>
        <ul class="space-y-3 text-gray-600">
          <li class="flex items-start">
            <i class="las la-check-circle text-primary-turquoise mt-1 mr-3"></i>
            <span data-i18n="menu.modules.videos">Cada plato como video corto generado con IA desde tus fotos</span>
          </li>
          <li class="flex items-start">
            <i class="las la-check-circle text-primary-turquoise mt-1 mr-3"></i>
            <span data-i18n="menu.modules.chatbot">Chatbot que responde precios, ingredientes, horarios y alergias 24/7</span>
          </li>
          <li class="flex items-start">
            <i class="las la-check-circle text-primary-turquoise mt-1 mr-3"></i>
            <span data-i18n="menu.modules.onelink">Un solo enlace, funciona en cualquier celular sin instalar nada</span>
          </li>
          <li class="flex items-start">
            <i class="las la-check-circle text-primary-turquoise mt-1 mr-3"></i>
            <span data-i18n="menu.modules.update">Cambias un precio y se actualiza en todas partes</span>
          </li>
        </ul>
      </div>

      <!-- Tech Stack -->
      <div class="reveal">
        <h3 class="text-2xl font-display font-semibold text-primary-dark mb-6" data-i18n="menu.techTitle">
          Tecnologías Utilizadas
        </h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-2 bg-primary-dark text-white text-sm rounded">Astro</span>
          <span class="px-3 py-2 bg-primary-dark text-white text-sm rounded">AI Video Generation</span>
          <span class="px-3 py-2 bg-primary-dark text-white text-sm rounded">LLM Chatbot</span>
          <span class="px-3 py-2 bg-primary-dark text-white text-sm rounded">React</span>
          <span class="px-3 py-2 bg-primary-dark text-white text-sm rounded">Tailwind CSS</span>
          <span class="px-3 py-2 bg-primary-dark text-white text-sm rounded">Node.js</span>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16 pt-8 border-t border-gray-100 reveal">
      <a
        href="https://wa.me/5354702549?text=Hola%20CodeVision%2C%20quiero%20ver%20una%20demo%20del%20Men%C3%BA%20Online%20con%20chatbot."
        target="_blank"
        rel="noopener noreferrer"
        class="btn-hover inline-flex items-center px-8 py-4 bg-primary-orange text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
      >
        <i class="lab la-whatsapp text-2xl mr-3"></i>
        <span data-i18n="menu.cta">Solicitar Demo</span>
      </a>
    </div>
  </div>
</section>
